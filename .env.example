# ──────────────────────────────────────────────
# Fikirden Ürüne Proje Vitrini — Lokal .env
# Bu dosyayı kopyalayıp ".env" olarak kaydedin
# ──────────────────────────────────────────────

# Supabase bağlantı string'i
# Supabase Dashboard → Settings → Database → Connection string → URI
# "Use connection pooling" kutusunu KAPATIN (port 5432 olmalı)
DATABASE_URL=postgresql://postgres:[ŞİFRENİZ]@db.[PROJE-REF].supabase.co:5432/postgres

# Oturum şifreleme anahtarı (en az 32 karakter, rastgele bir string)
SESSION_SECRET=buraya-cok-gizli-uzun-bir-anahtar-yazin

# Node ortamı
NODE_ENV=development
